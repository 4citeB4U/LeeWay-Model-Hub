# LEEWAY HEADER — DO NOT REMOVE
# REGION: MODEL_HUB / LOCAL_CONFIGURATION
# TAG: LEEWAY-MODEL-HUB-ENV-20261021
# WHO: Leonard Jerome Lee (owner), LeeWay Industries
# WHAT: Non-secret configuration examples
# WHEN: 2026-10-21
# WHERE: Host that performs model inference
# WHY: API separation without publishing protected tokens
# HOW: Configure as environment variables; never commit .env
MODEL_HUB_PORT=8879
MODEL_HUB_BIND=127.0.0.1
MODEL_HUB_TOKEN=REPLACE_WITH_PRIVATE_RANDOM_TOKEN
MODEL_HUB_OLLAMA_URL=http://127.0.0.1:11434
# Autowarm one approved model at startup; no client needs to download it
MODEL_HUB_AUTOSTART_MODEL=gemma-3-1b-q4km
MODEL_HUB_AUTOSTART_BACKEND=OLLAMA
# A negative Ollama keep_alive requests indefinite residency, subject to memory policy
MODEL_HUB_KEEP_ALIVE=-1
